# Copiar este archivo como .env y completar con claves reales (el .env no se sube a Git).
# src/main.py lo carga automáticamente al iniciar (python-dotenv).

# Proveedor principal (OpenAI). La clave necesita permiso para "Chat completions" y "Moderations".
OPENAI_API_KEY=tu_clave_openai

# Proveedor de fallback (Gemini)
GOOGLE_API_KEY=tu_clave_google

# Modelo de Gemini (opcional; si no se define, usa el valor por defecto de src/main.py)
GEMINI_MODEL=gemini-3.5-flash-lite
